{
  "name": "dsh-contract-renewal",
  "version": "0.1.0-alpha.1",
  "description": "Register contracts, list expired / renewal-window / soon-due exposure by a given date, and export CSV; local files only.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "TROUBLESHOOTING.md",
    "samples",
    "docs/assets",
    "screenshots.json",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/contracts.csv",
      "prompt": "把这 5 份合同登记进来，按 2026-12-01 看哪些已过期、哪些进了续签窗口、90 天内到期，再导出一份 CSV。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的合同登记 CSV（样例：samples/quickstart/input/contracts.csv）"
      ],
      "writes": [
        "$DSH_HOME/storages/dsh-contract-renewal/"
      ],
      "network": false,
      "external": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate": "node scripts/gate.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "quickstart": "node samples/quickstart/run.mjs --check",
    "prepublishOnly": "npm run build && node scripts/lint.mjs && node scripts/gate.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "contract",
    "renewal",
    "expiry",
    "legal",
    "csv",
    "perrylink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-contract-renewal.git"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-contract-renewal/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
